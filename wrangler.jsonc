// Publicação na Cloudflare (Workers com arquivos estáticos).
// O site é só a pasta site/: não há código rodando no servidor.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oquefizeramporvoce",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./site"
  },
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  }
}
